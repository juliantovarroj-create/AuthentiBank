# DATOS DE PRUEBA
# =====================================================================

def crear_autenticador() -> AutenticadorRFID:
    aut = AutenticadorRFID()
    # IMPORTANTE: cambia estos UID por los de tus tarjetas reales.
    aut.registrar_tarjeta("A3:4F:12:8B", Usuario("Sebas", "1234", CuentaAhorros("AH-001", 500_000)))
    aut.registrar_tarjeta("11:22:33:44", Usuario("Laura", "4321", CuentaCorriente("CO-001", 200_000, 100_000)))
    aut.registrar_tarjeta("55:66:77:88", Usuario("Carlos", "0000", CuentaAhorros("AH-002", 80_000)))
    return aut


# =====================================================================
# APLICACIÓN DE CONSOLA
# =====================================================================

def leer_monto(prompt: str = "Monto > ") -> int:
    texto = input(prompt).strip()
    limpio = texto.replace("$", "").replace(".", "").replace(",", "")
    if not limpio.isascii() or not limpio.isdigit():
        raise MontoInvalidoError(f"El monto '{texto}' no es un número válido.")
    return int(limpio)


def cambiar_pin(usuario: Usuario) -> None:
    actual = input("PIN actual > ").strip()
    nuevo = input("PIN nuevo (4 dígitos) > ").strip()
    confirmar = input("Repita el PIN nuevo > ").strip()
    if nuevo != confirmar:
        raise PinInvalidoError("Los PIN no coinciden. No se cambió nada.")
    usuario.cambiar_pin(actual, nuevo)
    print("PIN actualizado. Úselo en su próxima sesión.")


def mostrar_saldo(usuario: Usuario) -> None:
    c = usuario.cuenta
    print(f"\n{c.tipo} {c.numero} - Titular: {usuario.nombre}")
    print(f"Saldo: {cop(c.saldo)}")
    if isinstance(c, CuentaCorriente):
        print(f"Cupo de sobregiro: {cop(c.limite_sobregiro)} | Disponible: {cop(c.disponible)}")


def mostrar_movimientos(usuario: Usuario) -> None:
    movs = usuario.cuenta.movimientos[-6:][::-1]
    if not movs:
        print("Aún no hay movimientos.")
        return
    print(f"\n{'Hora':<10}{'Tipo':<12}{'Valor':>15}{'Saldo':>15}")
    for m in movs:
        print(f"{m.fecha:%H:%M:%S} {m.tipo:<12}{cop(m.monto):>15}{cop(m.saldo_resultante):>15}")


def menu(usuario: Usuario) -> None:
    cuenta = usuario.cuenta
    while True:
        print("\n1) Consultar saldo 2) Depositar 3) Retirar 4) Movimientos 5) Cambiar PIN 6) Salir")
        opcion = input("Opción > ").strip()
        try:
            if opcion == "1":
                mostrar_saldo(usuario)
            elif opcion == "2":
                Cajero.depositar(cuenta, leer_monto())
                print(f"Depósito exitoso. Saldo: {cop(cuenta.saldo)}")
            elif opcion == "3":
                Cajero.retirar(cuenta, leer_monto())
                print(f"Retiro exitoso. Saldo: {cop(cuenta.saldo)}")
            elif opcion == "4":
                mostrar_movimientos(usuario)
            elif opcion == "5":
                cambiar_pin(usuario)
            elif opcion == "6":
                print("Sesión cerrada. Retire su tarjeta.")
                return
            else:
                print("Opción no válida.")
        except CuentaBloqueadaError as e:
            print(f"BLOQUEADA: {e}")
            return
        except BancoError as e:
            print(f"OPERACIÓN RECHAZADA: {e}")


def atender_sesion(autenticador: AutenticadorRFID, uid: str) -> None:
    try:
        usuario = autenticador.validar_tarjeta(uid)
    except TarjetaNoRegistradaError as e:
        print(f"ACCESO DENEGADO: {e}")
        return

    print(f"Tarjeta reconocida. Hola, {usuario.nombre}.")

    while True: # segundo factor: PIN
        pin = input("PIN > ").strip()
        try:
            autenticador.validar_pin(usuario, pin)
            break
        except PinIncorrectoError as e:
            print(e)
        except CuentaBloqueadaError as e:
            print(f"BLOQUEADA: {e}")
            return

    menu(usuario)


# =====================================================================
# DEMOSTRACIÓN AUTOMÁTICA
# =====================================================================

def _titulo(texto: str) -> None:
    print(f"\n=== {texto} ===")


def _iniciar_sesion(aut: AutenticadorRFID, uid: str, *pines: str) -> Usuario | None:
    """Simula pasar la tarjeta y probar PINs en orden hasta que uno funcione o se bloquee."""
    try:
        usuario = aut.validar_tarjeta(uid)
    except TarjetaNoRegistradaError as e:
        print(f"ACCESO DENEGADO: {e}")
        return None
    print(f"Tarjeta reconocida: {usuario.nombre}")
    for pin in pines:
        try:
            aut.validar_pin(usuario, pin)
            print("PIN correcto. Acceso concedido.")
            return usuario
        except PinIncorrectoError as e:
            print(f" {e}")
        except CuentaBloqueadaError as e:
            print(f" BLOQUEADA: {e}")
            return None
    return None


def _operar(cuenta: Cuenta, accion: str, monto: int) -> None:
    try:
        if accion == "retiro":
            Cajero.retirar(cuenta, monto)
            print(f"Retiro de {cop(monto)} OK. Saldo: {cop(cuenta.saldo)}")
        else:
            Cajero.depositar(cuenta, monto)
            print(f"Depósito de {cop(monto)} OK. Saldo: {cop(cuenta.saldo)}")
    except BancoError as e:
        print(f"OPERACIÓN RECHAZADA: {e}")


def ejecutar_demo() -> None:
    aut = crear_autenticador()

    _titulo("1. Tarjeta NO registrada")
    _iniciar_sesion(aut, "FF:FF:FF:FF", "0000")

    _titulo("2. Cuenta de ahorros (Sebas)")
    sebas = _iniciar_sesion(aut, "A3:4F:12:8B", "9999", "1234") # primero falla, luego acierta
    if sebas:
        print(f"Saldo: {cop(sebas.cuenta.saldo)}")
        _operar(sebas.cuenta, "deposito", 50_000)
        _operar(sebas.cuenta, "retiro", 700_000) # rechazado: saldo insuficiente
        _operar(sebas.cuenta, "retiro", 200_000) # válido
        _operar(sebas.cuenta, "retiro", 15_000) # rechazado: no es múltiplo de $10.000
        _operar(sebas.cuenta, "retiro", -5) # rechazado: monto inválido

    _titulo("3. Cuenta corriente con sobregiro (Laura)")
    laura = _iniciar_sesion(aut, "11:22:33:44", "4321")
    if laura:
        _operar(laura.cuenta, "retiro", 250_000) # permitido: queda en -$50.000
        _operar(laura.cuenta, "retiro", 100_000) # rechazado: supera el cupo

    _titulo("4. Bloqueo por 3 PIN incorrectos (Carlos)")
    _iniciar_sesion(aut, "55:66:77:88", "1", "2", "3")
    print("-- Ahora intenta con el PIN correcto:")
    _iniciar_sesion(aut, "55:66:77:88", "0000")


# =====================================================================
# PROGRAMA PRINCIPAL
# =====================================================================

def main(argv: list[str]) -> None:
    if argv and argv[0].lower() == "listar":
        listar_puertos()
        return
    if argv and argv[0].lower() == "demo":
        ejecutar_demo()
        return

    autenticador = crear_autenticador()
    lector: LectorTarjeta
    try:
        if argv:
            lector = LectorSerial(argv[0])
            print("Modo REAL. Acerque una tarjeta al lector...")
        else:
            lector = LectorSimulado()
            print("Modo SIMULADO. Escriba un UID (ej: A3:4F:12:8B) o 'salir'.")
    except RuntimeError as e:
        print(f"ERROR: {e}")
        sys.exit(1)

    try:
        while True:
            uid = lector.esperar_tarjeta()
            if uid is None:
                break
            atender_sesion(autenticador, uid)
            if argv:
                print("\nAcerque una tarjeta al lector...")
    except (EOFError, KeyboardInterrupt):
        print("\nHasta luego.")
    except RuntimeError as e:
        print(f"\nERROR: {e}")
        sys.exit(1)
    finally:
        lector.cerrar()


if __name__ == "__main__":
    main(sys.argv[1:])

